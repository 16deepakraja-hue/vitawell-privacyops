# Copy this file to .env and set your PostgreSQL connection strings.
#
# DATABASE_URL = pooled connection (used by the app at runtime in serverless).
# DIRECT_URL   = direct/non-pooled connection (used by `prisma migrate`).
#
# LOCAL DEV: you can set BOTH to the same local connection string:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# PRODUCTION (Neon / Vercel Postgres / Supabase): use the *pooled* URL for
# DATABASE_URL (often contains `-pooler` and `?pgbouncer=true`) and the
# *direct* URL for DIRECT_URL.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitawell?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vitawell?schema=public"
